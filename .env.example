# Copy to .env and fill in only what you have. Nothing here costs money.
# Providers without a key are skipped automatically.

# Google AI Studio free tier -- https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# GitHub Models free tier -- a GitHub token with the "models" scope
# https://github.com/settings/tokens
GITHUB_TOKEN=
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Groq free tier -- https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras free tier -- https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama3.1-8b

# OpenRouter free models (ids end in ":free") -- https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Mistral free "Experiment" tier -- https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=open-mistral-nemo

# Local Ollama -- https://ollama.com  (no key, no account, no card)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2

# Any other OpenAI-compatible endpoint you already have
# CUSTOM_BASE_URL=
# CUSTOM_API_KEY=
# CUSTOM_MODEL=